<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>preview</LangVersion>
        <Nullable>disable</Nullable>

        <GameAssemblyPath>$(GorillaTagPath)/Gorilla Tag_Data/Managed</GameAssemblyPath>
        <LoaderAssemblyPath>$(GorillaTagPath)/BepInEx/core</LoaderAssemblyPath>
        <LoaderModsPath>$(GorillaTagPath)/BepInEx/plugins</LoaderModsPath>

        <Configurations>Debug;Release;</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <Target Name="CopyToPlugins" AfterTargets="Build">
        <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(LoaderModsPath)/ToniMacaroni's Mods/Computer Interface/$(TargetName).dll"/>
    </Target>

    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(GameAssemblyPath)/Assembly-CSharp.dll</HintPath>
        </Reference>
        <Reference Include="BepInEx">
            <HintPath>$(LoaderAssemblyPath)/BepInEx.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(GameAssemblyPath)/UnityEngine.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(GameAssemblyPath)/UnityEngine.CoreModule.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ComputerInterface\ComputerInterface.csproj" />
    </ItemGroup>
</Project>