<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>preview</LangVersion>
        <Nullable>disable</Nullable>

        <GameAssemblyPath>$(GorillaTagPath)/Gorilla Tag_Data/Managed</GameAssemblyPath>

        <Configurations>Debug;Release;MelonLoader;BepInEx</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <Target Name="CopyToPlugins" AfterTargets="Build">
        <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(LoaderModsPath)/ToniMacaroni's Mods/Computer Interface/$(TargetName).$(Configuration).dll"/>
    </Target>

    <PropertyGroup Condition="'$(Configuration)' == 'BepInEx'">
        <LoaderAssemblyPath>$(GorillaTagPath)/BepInEx/core</LoaderAssemblyPath>
        <LoaderModsPath>$(GorillaTagPath)/BepInEx/plugins</LoaderModsPath>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'BepInEx'">
        <Reference Include="BepInEx">
            <HintPath>$(LoaderAssemblyPath)/BepInEx.dll</HintPath>
        </Reference>
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'MelonLoader'">
        <LoaderAssemblyPath>$(GorillaTagPath)/MelonLoader/net35</LoaderAssemblyPath>
        <LoaderModsPath>$(GorillaTagPath)/Mods</LoaderModsPath>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'MelonLoader'">
        <Reference Include="MelonLoader">
            <HintPath>$(LoaderAssemblyPath)/MelonLoader.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(GameAssemblyPath)/Assembly-CSharp.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(GameAssemblyPath)/UnityEngine.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(GameAssemblyPath)/UnityEngine.CoreModule.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="../ComputerInterface/ComputerInterface.csproj" />
    </ItemGroup>
</Project>